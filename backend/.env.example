# ==============================================
# ChatAI MCP - Configuration Environnement
# ==============================================

# === SERVER CONFIGURATION ===
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# === DATABASE CONFIGURATION (PostgreSQL) ===
# Pour développement local
DB_HOST=localhost
DB_PORT=5432
DB_NAME=chataimcp
DB_USER=postgres
DB_PASSWORD=postgres

# Pour production (utiliser une connection string)
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# === JWT AUTHENTICATION ===
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# === AI MODEL CONFIGURATION ===
# Google Gemini API Key (requis)
GEMINI_API_KEY=your-gemini-api-key-here

# Claude API Key (optionnel, pour futur support multi-LLM)
# ANTHROPIC_API_KEY=your-anthropic-api-key-here

# === GOOGLE OAUTH2 (pour Gmail, Drive) ===
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3001/auth/google/callback

# === MICROSOFT OAUTH2 (pour Outlook, OneDrive) ===
# MICROSOFT_CLIENT_ID=your-microsoft-client-id
# MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret
# MICROSOFT_REDIRECT_URI=http://localhost:3001/auth/microsoft/callback

# === GITHUB OAUTH2 (pour GitHub MCP Server) ===
# GITHUB_CLIENT_ID=your-github-client-id
# GITHUB_CLIENT_SECRET=your-github-client-secret
# GITHUB_REDIRECT_URI=http://localhost:3001/auth/github/callback

# === SLACK OAUTH2 (pour Slack MCP Server) ===
# SLACK_CLIENT_ID=your-slack-client-id
# SLACK_CLIENT_SECRET=your-slack-client-secret
# SLACK_REDIRECT_URI=http://localhost:3001/auth/slack/callback

# === API KEYS FOR MCP SERVERS ===
# Brave Search API (pour web search MCP server)
# BRAVE_SEARCH_API_KEY=your-brave-search-api-key

# Notion API (pour Notion MCP server)
# NOTION_API_KEY=your-notion-integration-token

# === MCP SERVER PATHS ===
# Chemin vers les serveurs MCP personnalisés
MCP_SERVERS_PATH=./mcp-servers

# Dossiers autorisés pour le filesystem MCP server (séparés par des virgules)
FILESYSTEM_ALLOWED_PATHS=/home/user/documents,/home/user/projects

# === LOGGING & MONITORING ===
# Niveau de log (debug, info, warn, error)
LOG_LEVEL=info

# Activer les logs détaillés MCP
MCP_DEBUG=false

# === RATE LIMITING ===
# Nombre max de requêtes par minute par utilisateur
RATE_LIMIT_PER_MINUTE=100

# Nombre max d'appels d'outils MCP par conversation
MAX_TOOL_CALLS_PER_CONVERSATION=50

# === REDIS (optionnel, pour cache et sessions) ===
# REDIS_URL=redis://localhost:6379
# REDIS_PASSWORD=your-redis-password

# === MULTI-TENANCY (pour usage entreprise) ===
# Activer le mode multi-tenant
MULTI_TENANT_MODE=false

# === STORAGE (pour fichiers uploadés) ===
# Type de storage (local, s3, gcs)
STORAGE_TYPE=local

# Chemin local pour uploads
UPLOAD_PATH=./uploads

# AWS S3 (si STORAGE_TYPE=s3)
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key
# AWS_S3_BUCKET=your-bucket-name
# AWS_REGION=us-east-1

# === SECURITY ===
# Timeout des connexions MCP inactives (en millisecondes)
MCP_IDLE_TIMEOUT=1800000

# Timeout des requêtes HTTP (en millisecondes)
HTTP_TIMEOUT=30000

# Activer HTTPS en production
# FORCE_HTTPS=true

# === ANALYTICS (optionnel) ===
# Activer le tracking d'usage
# ENABLE_ANALYTICS=true
# ANALYTICS_PROVIDER=posthog
# POSTHOG_API_KEY=your-posthog-key

# === EMAILS (pour notifications) ===
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-email-password
# EMAIL_FROM=noreply@chataimcp.com

# ==============================================
# NOTES:
# - Changez TOUS les secrets en production
# - N'utilisez JAMAIS ces valeurs par défaut en production
# - Ajoutez ce fichier à .gitignore
# - Utilisez un gestionnaire de secrets (AWS Secrets Manager, etc.)
# ==============================================
