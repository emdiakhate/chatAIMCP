# ==============================================
# ChatAI MCP - Configuration Environnement
# ==============================================

# === SERVER CONFIGURATION ===
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# === DATABASE CONFIGURATION ===
# SQLite (par défaut pour développement)
DATABASE_PATH=./database/chatai.db

# PostgreSQL (optionnel, pour production)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=chataimcp
# DB_USER=postgres
# DB_PASSWORD=postgres
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# === JWT AUTHENTICATION ===
# Generate with: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# === ENCRYPTION (for storing API keys) ===
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=your-64-char-hex-encryption-key-change-this-in-production

# === AI MODEL CONFIGURATION ===
# OpenRouter (recommended, multi-model access)
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Groq (recommended, free Llama 70B)
GROQ_API_KEY=your-groq-api-key-here

# Google Gemini (optional)
GEMINI_API_KEY=your-gemini-api-key-here

# Direct API Keys (optional, if not using MCP servers)
ANTHROPIC_API_KEY=your-anthropic-api-key-here
OPENAI_API_KEY=your-openai-api-key-here

# === GOOGLE OAUTH2 (Gmail, Drive, Sheets) ===
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback

# === SLACK OAUTH2 ===
SLACK_CLIENT_ID=your-slack-client-id
SLACK_CLIENT_SECRET=your-slack-client-secret
SLACK_REDIRECT_URI=http://localhost:3001/api/auth/slack/callback

# === SALESFORCE OAUTH2 ===
SALESFORCE_CLIENT_ID=your-salesforce-client-id
SALESFORCE_CLIENT_SECRET=your-salesforce-client-secret
SALESFORCE_REDIRECT_URI=http://localhost:3001/api/auth/salesforce/callback

# === MICROSOFT TEAMS OAUTH2 ===
TEAMS_CLIENT_ID=your-teams-client-id
TEAMS_CLIENT_SECRET=your-teams-client-secret
TEAMS_REDIRECT_URI=http://localhost:3001/api/auth/teams/callback
TEAMS_TENANT_ID=common

# === GITHUB OAUTH2 (optional) ===
# GITHUB_CLIENT_ID=your-github-client-id
# GITHUB_CLIENT_SECRET=your-github-client-secret
# GITHUB_REDIRECT_URI=http://localhost:3001/api/auth/github/callback

# === MICROSOFT OAUTH2 (optional, for Outlook, OneDrive) ===
# MICROSOFT_CLIENT_ID=your-microsoft-client-id
# MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret
# MICROSOFT_REDIRECT_URI=http://localhost:3001/api/auth/microsoft/callback

# === API KEYS FOR MCP SERVERS ===
# These can also be configured via the UI (encrypted storage)
HUBSPOT_API_KEY=your-hubspot-api-key
AIRTABLE_API_KEY=your-airtable-api-key
LINEAR_API_KEY=your-linear-api-key

# Optional MCP servers
# BRAVE_SEARCH_API_KEY=your-brave-search-api-key
# NOTION_API_KEY=your-notion-integration-token

# === MCP SERVER PATHS ===
# Chemin vers les serveurs MCP personnalisés
MCP_SERVERS_PATH=./mcp-servers

# Dossiers autorisés pour le filesystem MCP server (séparés par des virgules)
FILESYSTEM_ALLOWED_PATHS=/home/user/documents,/home/user/projects

# === LOGGING & MONITORING ===
# Niveau de log (debug, info, warn, error)
LOG_LEVEL=info

# Activer les logs détaillés MCP
MCP_DEBUG=false

# === RATE LIMITING ===
# Nombre max de requêtes par minute par utilisateur
RATE_LIMIT_PER_MINUTE=100

# Nombre max d'appels d'outils MCP par conversation
MAX_TOOL_CALLS_PER_CONVERSATION=50

# === REDIS (optionnel, pour cache et sessions) ===
# REDIS_URL=redis://localhost:6379
# REDIS_PASSWORD=your-redis-password

# === MULTI-TENANCY (pour usage entreprise) ===
# Activer le mode multi-tenant
MULTI_TENANT_MODE=false

# === STORAGE (pour fichiers uploadés) ===
# Type de storage (local, s3, gcs)
STORAGE_TYPE=local

# Chemin local pour uploads
UPLOAD_PATH=./uploads

# AWS S3 (si STORAGE_TYPE=s3)
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key
# AWS_S3_BUCKET=your-bucket-name
# AWS_REGION=us-east-1

# === SECURITY ===
# Timeout des connexions MCP inactives (en millisecondes)
MCP_IDLE_TIMEOUT=1800000

# Timeout des requêtes HTTP (en millisecondes)
HTTP_TIMEOUT=30000

# Activer HTTPS en production
# FORCE_HTTPS=true

# === ANALYTICS (optionnel) ===
# Activer le tracking d'usage
# ENABLE_ANALYTICS=true
# ANALYTICS_PROVIDER=posthog
# POSTHOG_API_KEY=your-posthog-key

# === EMAILS (pour notifications) ===
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-email-password
# EMAIL_FROM=noreply@chataimcp.com

# ==============================================
# NOTES:
# - Changez TOUS les secrets en production
# - N'utilisez JAMAIS ces valeurs par défaut en production
# - Ajoutez ce fichier à .gitignore
# - Utilisez un gestionnaire de secrets (AWS Secrets Manager, etc.)
# ==============================================
